# Which data provider to use: linkedin | proxycurl | fixture
PROVIDER=linkedin

# ── LinkedIn Voyager provider (PROVIDER=linkedin) ─────────────────────────────
# Obtain these from your browser after logging in to linkedin.com:
#   DevTools → Application → Cookies → linkedin.com
#
# li_at  : your session token (the long cookie value)
# JSESSIONID : the JSESSIONID cookie value, e.g.  ajax:1234567890
#              (paste exactly as it appears in the browser, without surrounding quotes)
LI_AT=your_li_at_cookie_value_here
LI_JSESSIONID=ajax:your_jsessionid_value_here

# ── Proxycurl provider (PROVIDER=proxycurl) ───────────────────────────────────
# Licensed provider — get a key from https://nubela.co/proxycurl
PROXYCURL_API_KEY=

# ── Claude AI analysis (GET /analyze) ────────────────────────────────────────
# Required for the /analyze endpoint. Get a key from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Optional: protect your own endpoint ──────────────────────────────────────
# If set, callers must pass X-API-Key: <value> in every request.
API_KEY=

# Upstream request timeout in seconds
REQUEST_TIMEOUT=30
